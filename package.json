  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "axios": "^1.7.9",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "form-data": "^4.0.1",
    "rxjs": "^7.8.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.13.0",
    "cypress": "^15.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
