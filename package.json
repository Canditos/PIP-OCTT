  "description": "MCP servers for OCPP certification automation — OCTT, Keysight CDS, and Jira integration",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev:octt": "tsx src/mcp-servers/octt/index.ts",
    "dev:cds": "tsx src/mcp-servers/cds/index.ts",
